{
  "display_information": {
    "name": "startupfans",
    "description": "Publish team updates with a megaphone reaction",
    "background_color": "#181818"
  },
  "features": {
    "bot_user": { "display_name": "startupfans", "always_online": false }
  },
  "oauth_config": {
    "redirect_urls": ["https://www.startupfans.co/api/slack/oauth"],
    "scopes": {
      "bot": ["reactions:read", "channels:history", "groups:history", "users:read", "users:read.email", "files:read", "chat:write"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://www.startupfans.co/api/slack/events",
      "bot_events": ["reaction_added"]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
