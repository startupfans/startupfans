# Shared Neon database (do not commit real values; copy from the team .env)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
APP_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM="startupfans <fans@startupfans.co>"
# Read-write token from the Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
# At least 32 random characters; signs internal video-processing jobs. Configure on Vercel.
MEDIA_JOB_SECRET=
# At least 32 random characters; signs notification email unsubscribe links.
NOTIFY_EMAIL_SECRET=
# Optional. Rewrites scraped homepage copy into tagline/bio/description on /start.
# Without it, brand lookup still returns raw meta descriptions. Add in Vercel for prod.
OPENAI_API_KEY=
# Comma-separated email addresses or @domain entries allowed to moderate all posts and startups (case-insensitive, exact domains only).
ADMIN_EMAILS=
# Slack app credentials from Basic Information. All four Slack values are required.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# 32 random bytes encoded as base64; encrypts stored Slack tokens with AES-256-GCM.
# Generate with: openssl rand -base64 32. Keep this key stable and secret.
SLACK_TOKEN_KEY=

# PostHog browser analytics configuration.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host
