# Shared Neon database (do not commit real values; copy from the team .env)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
APP_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM="startupfans <fans@startupfans.co>"
# Read-write token from the Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
# Comma-separated email addresses of users allowed to moderate all posts and startups.
ADMIN_EMAILS=
# Slack app credentials from Basic Information. All four Slack values are required.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# 32 random bytes encoded as base64; encrypts stored Slack tokens with AES-256-GCM.
# Generate with: openssl rand -base64 32. Keep this key stable and secret.
SLACK_TOKEN_KEY=

# GetWaitlist (dashboard API key; waitlist id 33121 is hardcoded in app/waitlist-form.tsx)
WAITLIST_API_KEY=
# Signup alerts: GetWaitlist posts to /api/waitlist/webhook?secret=<WAITLIST_WEBHOOK_SECRET>,
# which forwards a one-line message to this Slack incoming webhook (#startupfans).
# Generate the secret with: openssl rand -hex 24
WAITLIST_WEBHOOK_SECRET=
SLACK_WAITLIST_WEBHOOK_URL=

# PostHog browser analytics configuration.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host
